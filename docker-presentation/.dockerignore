# ================================================
# .dockerignore for NextOrder Application
# ================================================
# Files and directories to exclude from Docker build
# This reduces image size and build time
# ================================================

# Dependencies (will be installed in container)
node_modules
npm-debug.log

# Environment files (sensitive data)
.env
.env.local
.env.production

# Git files
.git
.gitignore

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation
README.md
docs/

# Test files
*.test.js
*.spec.js
coverage/

# Docker files (prevent recursive copying)
docker-compose*.yml
Dockerfile*
