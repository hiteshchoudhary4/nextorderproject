# ================================================
# .dockerignore for NextOrder Application
# ================================================
# Files and directories to exclude from Docker build
# This reduces image size and build time
# ================================================

# Dependencies (will be installed in container)
node_modules
npm-debug.log

# Environment files (contains secrets!)
.env
.env.local
.env.production

# Git files
.git
.gitignore

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Documentation & Presentation folders
docker-presentation
git-presentation
README.md
LinkedIn_Post.md
NextOrder_Presentation.md
NextOrder_Report.md
Presentation_Visuals.md
DEVOPS_SHOWCASE.md

# Test files
*.test.js
*.spec.js
coverage/

# Docker files (prevent recursive copying)
docker-compose*.yml
Dockerfile*
